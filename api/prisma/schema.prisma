// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DONO
  FUNCIONARIA
}

model Loja {
  id        Int       @id @default(autoincrement())
  nome      String
  cnpj      String?
  plano     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  filiais   Filial[]
  usuarios  Usuario[]
  produtos  Produto[]
  vendas    Venda[]
  clientes  Cliente[]
  caixas    Caixa[]
}

model Filial {
  id        Int       @id @default(autoincrement())
  lojaId    Int
  loja      Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome      String
  endereco  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  usuarios  Usuario[]
  vendas    Venda[]
  caixas    Caixa[]
}

model Usuario {
  id        Int         @id @default(autoincrement())
  lojaId    Int
  loja      Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  filialId  Int
  filial    Filial      @relation(fields: [filialId], references: [id], onDelete: Cascade)
  nome      String
  email     String      @unique
  senhaHash String
  role      Role
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  vendas     Venda[]
  pushTokens PushToken[]
  caixasAbertos  Caixa[] @relation("AberturaCaixa")
  caixasFechados Caixa[] @relation("FechamentoCaixa")
}

model PushToken {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Produto {
  id         Int         @id @default(autoincrement())
  lojaId     Int
  loja       Loja        @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome       String
  categoria  String
  preco      Float
  estoque    Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  itensVenda ItemVenda[]
}

model Cliente {
  id        Int       @id @default(autoincrement())
  lojaId    Int
  loja      Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome      String
  telefone  String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vendas    Venda[]

  @@unique([lojaId, telefone])
}

enum FormaPagamento {
  DINHEIRO
  CREDITO
  DEBITO
  PIX
}

model Venda {
  id             Int            @id @default(autoincrement())
  uuid           String         @unique // Identificador único gerado no cliente para idempotência
  lojaId         Int
  loja           Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  filialId       Int
  filial         Filial         @relation(fields: [filialId], references: [id], onDelete: Cascade)
  usuarioId      Int
  usuario        Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clienteId      Int?
  cliente        Cliente?       @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  caixaId        Int?
  caixa          Caixa?         @relation(fields: [caixaId], references: [id], onDelete: SetNull)
  dataHora       DateTime       @default(now())
  valorTotal     Float
  formaPagamento FormaPagamento
  observacao     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  itens          ItemVenda[]

  @@index([usuarioId, createdAt])
  @@index([filialId, createdAt])
  @@index([lojaId, createdAt])
  @@index([caixaId])
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

model Caixa {
  id                   Int                 @id @default(autoincrement())
  lojaId               Int
  loja                 Loja                @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  filialId             Int
  filial               Filial              @relation(fields: [filialId], references: [id], onDelete: Cascade)
  usuarioAberturaId    Int
  usuarioAbertura      Usuario             @relation("AberturaCaixa", fields: [usuarioAberturaId], references: [id])
  usuarioFechamentoId  Int?
  usuarioFechamento    Usuario?            @relation("FechamentoCaixa", fields: [usuarioFechamentoId], references: [id])
  status               StatusCaixa         @default(ABERTO)
  dataAbertura         DateTime            @default(now())
  dataFechamento       DateTime?
  saldoInicial         Float
  saldoFinalReal       Float?
  saldoFinalEsperado   Float?
  diferenca            Float?
  observacao           String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  vendas               Venda[]
  movimentacoes        MovimentacaoCaixa[]

  @@index([filialId, status])
  @@index([lojaId])
}

model MovimentacaoCaixa {
  id        Int              @id @default(autoincrement())
  caixaId   Int
  caixa     Caixa            @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  tipo      TipoMovimentacao
  valor     Float
  descricao String
  createdAt DateTime         @default(now())
}

model ItemVenda {
  id            Int      @id @default(autoincrement())
  vendaId       Int
  venda         Venda    @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id])
  quantidade    Int
  valorUnitario Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
